# ---------------------------------------------------------------------------
# Shopware 6 Docs RAG - configuration (copy to .env)
# Every variable maps 1:1 to a field in app/config.py.
# ---------------------------------------------------------------------------

# --- LLM used to write answers -----------------------------------------------
# anthropic | openai | ollama | extractive (no LLM: returns the best passage, cited)
LLM_PROVIDER=anthropic
# Empty = provider default (anthropic: claude-opus-5-5, openai: gpt-4.1-mini, ollama: qwen2.5:3b)
LLM_MODEL=
# Anthropic/OpenAI key (for Anthropic you can also export ANTHROPIC_API_KEY or use `ant auth login`)
LLM_API_KEY=
# Claude cost/latency knob (current Claude models do not accept a temperature)
ANTHROPIC_EFFORT=low
# Only if your key is NOT scoped to a workspace (error "must include the anthropic-workspace-id header")
ANTHROPIC_WORKSPACE_ID=
# Only for OpenAI-compatible servers (vLLM, LM Studio, Azure ...)
LLM_BASE_URL=
# Local models: `make up-ollama` (docker compose sets this to http://ollama:11434 inside the network)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
LLM_TEMPERATURE=0

# --- Judge model for the LLM-based eval metrics (keep it FIXED across runs) ----
# Empty = same provider as LLM_PROVIDER with its default model
JUDGE_PROVIDER=
JUDGE_MODEL=

# --- Embeddings (local ONNX via fastembed, or OpenAI) ---------------------------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=ibm-granite/granite-embedding-small-english-r2
EMBEDDING_MAX_TOKENS=1024
# Only if EMBEDDING_PROVIDER=openai (e.g. EMBEDDING_MODEL=text-embedding-3-small)
OPENAI_API_KEY=

# --- Retrieval ------------------------------------------------------------------
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# "I could not find it" gate on the cross-encoder score of the context. Calibrate per generator:
# python -m eval.calibrate. Empty for qwen2.5:3b (it refuses on its own); 1.26 on retrieval alone.
RERANK_THRESHOLD=
RETRIEVAL_CANDIDATES=30
RRF_K=60
# Weight of BM25 in the fusion (dense = 1.0). 1.0 = classic RRF; 0.5 measured better on this corpus.
HYBRID_SPARSE_WEIGHT=0.5
DEFAULT_TOP_K=6

# --- Vector store -----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=shopware_docs

# --- Source docs (pin the commit for reproducible evals) ---------------------------
DOCS_REPO_URL=https://github.com/shopware/docs.git
DOCS_COMMIT=7ab78da5845834c1d45cfcbd4df39d9bc224f967

# --- API ------------------------------------------------------------------------------
# Enables POST /ingest (send it as the X-Admin-Token header). Empty = endpoint disabled.
ADMIN_TOKEN=
LOG_LEVEL=INFO
